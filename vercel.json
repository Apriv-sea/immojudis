{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "github": {
    "silent": true
  },
  "installCommand": "npx --yes --package=npm@11.18.0 -c 'npm ci'",
  "buildCommand": "npm run build",
  "regions": [
    "cdg1"
  ],
  "crons": [
    {
      "path": "/api/cron/smart-alerts",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/cron/alert-notifications",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/sale-change-monitor",
      "schedule": "45 6 * * *"
    },
    {
      "path": "/api/cron/data-retention",
      "schedule": "15 4 * * 0"
    },
    {
      "path": "/api/cron/operational-health",
      "schedule": "0 7 * * *"
    }
  ]
}
